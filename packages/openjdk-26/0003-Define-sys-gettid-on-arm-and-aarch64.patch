From rebased@local Fri Apr 18 22:00:00 2026
Subject: [PATCH] Define SYS_gettid for arm/aarch64

The dlvsym MUSL_LIBC || __ANDROID__ gate is already added by patch 0002,
so this patch only handles the SYS_gettid syscall numbers for arm/aarch64.

--- a/src/hotspot/os/linux/os_linux.cpp
+++ b/src/hotspot/os/linux/os_linux.cpp
@@ -464,11 +464,13 @@
 }

 #ifndef SYS_gettid
-// i386: 224, amd64: 186
-  #if defined(__i386__)
+// i386 & arm: 224, amd64: 186, aarch64: 178
+  #if defined(__i386__) || defined(__arm__)
     #define SYS_gettid 224
   #elif defined(__amd64__)
     #define SYS_gettid 186
+  #elif defined(__arm64__) || defined(__aarch64__)
+    #define SYS_gettid 178
   #else
     #error "Define SYS_gettid for this architecture"
   #endif
