From rebased@local Fri Apr 18 22:00:00 2026
Subject: [PATCH] sys_gettid for arm/aarch64 + dlvsym ANDROID gate (rebased for jdk26)

--- a/src/hotspot/os/linux/os_linux.cpp	2026-02-13 00:13:35.000000000 +0900
+++ b/src/hotspot/os/linux/os_linux.cpp	2026-04-18 21:12:29.652988045 +0900
@@ -134,7 +134,7 @@
 
 #define MAX_PATH    (2 * K)
 
-#ifdef MUSL_LIBC
+#if defined(MUSL_LIBC) || defined(__ANDROID__)
 // dlvsym is not a part of POSIX
 // and musl libc doesn't implement it.
 static void *dlvsym(void *handle,
@@ -464,11 +464,13 @@
 }
 
 #ifndef SYS_gettid
-// i386: 224, amd64: 186
-  #if defined(__i386__)
+// i386 & arm: 224, amd64: 186, aarch64: 178
+  #if defined(__i386__) || defined(__arm__)
     #define SYS_gettid 224
   #elif defined(__amd64__)
     #define SYS_gettid 186
+  #elif defined(__arm64__) || defined(__aarch64__)
+    #define SYS_gettid 178
   #else
     #error "Define SYS_gettid for this architecture"
   #endif
